<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenIddict 7.x：Me BFF 作为第一方 OIDC 客户端接入 IDP -->
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.0" />
    <PackageVersion Include="OpenIddict.Client.SystemNetHttp" Version="7.7.0" />
    <!-- 测试（取值与 panda-auth-server 的测试工程保持一致，避免同一工作区两套测试栈） -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
